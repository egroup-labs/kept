{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kept",
  "version": "1.0.0",
  "identifier": "com.markmarosi.kept",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kept",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' http://localhost:18241 http://127.0.0.1:18241 https: data: blob:; connect-src 'self' http://localhost:18241 http://127.0.0.1:18241 https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "resources": {
      "../../extension": "extension"
    },
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Local vault for AI conversations",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4MDcwODk5QTg1MUFCNTQKUldSVXExR29tUWdIU0dxNmdVNloreDgyOWJKLzcvWXIyL3RhcVNTcWpIRitPWFlJSzF4UlhJWTIK",
      "endpoints": [
        "https://kept.work/api/v1/update"
      ]
    }
  }
}